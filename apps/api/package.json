{
  "name": "@lazysentry/api",
  "private": true,
  "version": "1.5.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/main.ts --with-worker",
    "dev:api": "tsx watch src/api.ts",
    "dev:worker": "tsx watch src/worker.ts",
    "db:generate": "drizzle-kit generate",
    "scan:once": "tsx src/scripts/scan-once.ts",
    "scanner:checksums": "tsx src/scripts/print-scanner-checksums.ts",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@fastify/cookie": "^11.0.0",
    "@fastify/helmet": "^13.0.0",
    "@fastify/rate-limit": "^10.0.0",
    "@fastify/session": "^11.0.0",
    "@fastify/static": "^10.0.0",
    "@lazysentry/shared": "workspace:*",
    "argon2": "^0.45.0",
    "better-sqlite3": "^12.0.0",
    "drizzle-orm": "^0.45.0",
    "fastify": "^5.0.0",
    "semver": "^7.8.5",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.0",
    "@types/node": "^22.0.0",
    "@types/semver": "^7.8.0",
    "drizzle-kit": "^0.31.0",
    "tsx": "^4.0.0",
    "typescript": "^5.9.0",
    "vitest": "^5.0.0"
  }
}
