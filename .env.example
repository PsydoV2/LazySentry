# Copy this file to `.env` and fill in the values.
# NEVER commit your real `.env` — it is ignored by git.
#
# Using docker-compose.yml? Only APP_ENCRYPTION_KEY (required) and, if
# needed, HTTPS / APP_ORIGIN matter here — HOST, DATABASE_PATH,
# OSV_SCANNER_PATH and TRUFFLEHOG_PATH are pinned to the correct in-container
# values by docker-compose.yml itself and ignored. See docs/SETUP.md.

# Master key for encrypting stored tokens & settings (AES-256-GCM).
# Must be a 64-character hex string (32 random bytes). The app refuses to
# start without it. Generate one with:
#   openssl rand -hex 32
APP_ENCRYPTION_KEY=

# HTTP server bind address. Default is loopback only — expose the dashboard
# deliberately via a reverse proxy, not by binding to 0.0.0.0.
HOST=127.0.0.1
PORT=3111

# Set to true when the dashboard is served over HTTPS, so the session cookie
# gets the `Secure` attribute.
HTTPS=false

# Only needed if your reverse proxy rewrites the Host header. State-changing
# requests check the Origin header against Host; set this to the public URL
# when that comparison cannot work.
#APP_ORIGIN=https://sentry.example.com

# Path to the SQLite database file (created on first start).
DATABASE_PATH=./data/lazysentry.db

# Path to the osv-scanner binary. Defaults to `osv-scanner` on PATH (the
# Docker image provides it). For local development, download a pinned release
# from https://github.com/google/osv-scanner/releases and point this at it.
#OSV_SCANNER_PATH=./tools/osv-scanner.exe

# Path to the trufflehog binary. Same convention as OSV_SCANNER_PATH above;
# download a pinned release from
# https://github.com/trufflesecurity/trufflehog/releases for local dev.
#TRUFFLEHOG_PATH=./tools/trufflehog.exe
