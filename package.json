{
  "name": "lazysentry",
  "private": true,
  "version": "1.5.0",
  "description": "Self-hosted security & maintenance dashboard for your repositories",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --filter @lazysentry/shared build && pnpm --parallel --filter \"./apps/*\" dev",
    "build": "pnpm -r build",
    "test": "pnpm --filter @lazysentry/shared build && pnpm -r test",
    "typecheck": "pnpm --filter @lazysentry/shared build && pnpm -r typecheck"
  }
}
